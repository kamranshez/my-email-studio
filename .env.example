# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your email and API key are never committed.
# Values in .claude/settings.local.json win over values here.

# Your own email. The send guard lets test emails go to this address.
MY_EMAIL=you@example.com

# Live mode: your real Resend account.
# For practice mode, delete these two lines (the practice server at
# http://localhost:4000 is used instead).
RESEND_BASE_URL=https://api.resend.com
RESEND_API_KEY=re_your_real_key_here
